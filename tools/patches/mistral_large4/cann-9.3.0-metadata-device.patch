--- /dev/null
+++ b/cann_ops_transformer/utils/metadata_device.py
@@ -0,0 +1,44 @@
+"""Resolve the per-device core counts used by CANN metadata schedulers."""
+
+from functools import lru_cache
+
+import acl
+import torch
+
+# aclrtDevAttr values from acl/acl_rt.h, rather than SKU core capacities.
+ACL_DEV_ATTR_AICORE_CORE_NUM = 101
+ACL_DEV_ATTR_VECTOR_CORE_NUM = 201
+ACL_SUCCESS = 0
+
+
+@lru_cache(maxsize=None)
+def _query_metadata_core_counts(device_index: int) -> tuple[int, int]:
+    counts = []
+    for attribute in (ACL_DEV_ATTR_AICORE_CORE_NUM, ACL_DEV_ATTR_VECTOR_CORE_NUM):
+        count, status = acl.rt.get_device_info(device_index, attribute)
+        if status != ACL_SUCCESS or count <= 0:
+            raise RuntimeError(
+                f"Cannot query metadata core count for device {device_index}, "
+                f"attribute {attribute}: status={status}, count={count}"
+            )
+        counts.append(count)
+    return counts[0], counts[1]
+
+
+def get_metadata_core_counts(device=None) -> tuple[int, int]:
+    # Torch owns runtime initialization; do not initialize/finalize ACL here.
+    current = torch.npu.current_device()
+    if device is None:
+        device_index = current
+    elif isinstance(device, bool):
+        raise TypeError("A metadata device must be an index or an NPU device")
+    elif isinstance(device, int):
+        device_index = device
+    else:
+        resolved = torch.device(device)
+        if resolved.type != "npu":
+            raise ValueError(f"Metadata requires an NPU device, got {resolved}")
+        device_index = current if resolved.index is None else resolved.index
+    if device_index < 0:
+        raise ValueError(f"Invalid metadata device index: {device_index}")
+    return _query_metadata_core_counts(device_index)
